SUPABASE_PROJECT_REF=ref
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321/
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=publishable_key
# Server-only. Required for account closure (Auth admin deleteUser) and archive vault.
# Never expose this to the browser or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=service_role_key

# Server-only. Symmetric key used to encrypt contact-form payloads at rest.
# Generate a long random secret (32+ bytes). Never commit a real value.
CONTACT_ENCRYPTION_KEY=

# Public privacy / data-protection contact (shown on privacy policy and related copy).
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@juthoor.app
